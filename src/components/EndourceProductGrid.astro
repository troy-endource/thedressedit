---
interface Props {
  sectionTitle?: string;
  productUrls: string[];
  endourceLink?: string;
}

const { sectionTitle, productUrls, endourceLink } = Astro.props;
const id = 'url-grid-' + Math.random().toString(36).slice(2, 8);
---

<div class="product-section">
  <div class="product-section-header">
    {sectionTitle && <h3 class="product-section-title">{sectionTitle}</h3>}
    {endourceLink && (
      <a href={endourceLink} target="_blank" rel="noopener" class="product-section-link">
        Shop all on endource →
      </a>
    )}
  </div>

  <div class="product-grid" id={id}>
    {productUrls.map(() => (
      <div class="product-card">
        <div class="product-card-image" style="animation: pulse 1.5s ease-in-out infinite; background: var(--light-grey);"></div>
        <div style="height:10px;width:60%;background:var(--light-grey);margin-bottom:8px;animation:pulse 1.5s ease-in-out infinite;"></div>
        <div style="height:10px;width:85%;background:var(--light-grey);margin-bottom:8px;animation:pulse 1.5s ease-in-out infinite;"></div>
        <div style="height:10px;width:30%;background:var(--light-grey);animation:pulse 1.5s ease-in-out infinite;"></div>
      </div>
    ))}
  </div>
</div>

<script define:vars={{ id, productUrls }}>
  (function() {
    var grid = document.getElementById(id);

    function esc(str) {
      if (!str) return '';
      var d = document.createElement('div');
      d.textContent = String(str);
      return d.innerHTML;
    }

    function escAttr(str) {
      if (!str) return '';
      return String(str).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    function formatPrice(price, currency) {
      if (!price && price !== 0) return '';
      var priceStr = String(price);
      if (priceStr.match(/[£$€]/)) return priceStr;
      var num = parseFloat(priceStr.replace(/[^0-9.]/g, ''));
      if (isNaN(num)) return priceStr;
      var symbol = currency === 'USD' ? '$' : currency === 'EUR' ? '€' : '£';
      if (num % 1 === 0) return symbol + num.toLocaleString('en-GB');
      return symbol + num.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function renderProduct(p, fallbackUrl) {
      var productUrl = p.url || fallbackUrl;
      if (productUrl.startsWith('/')) productUrl = 'https://www.endource.com' + productUrl;
      var priceDisplay = formatPrice(p.price, p.currency);

      return '<a href="' + escAttr(productUrl) + '" target="_blank" rel="noopener" class="product-card">' +
        '<div class="product-card-image">' +
          (p.image ? '<img src="' + escAttr(p.image) + '" alt="' + escAttr(p.name) + '" loading="lazy" />' : '') +
        '</div>' +
        (p.brand ? '<p class="product-brand">' + esc(p.brand) + '</p>' : '') +
        '<p class="product-name">' + esc(p.name || 'View product') + '</p>' +
        (priceDisplay ? '<span class="product-price">' + esc(priceDisplay) + '</span>' : '') +
        (p.retailer ? ' <span class="product-retailer">' + esc(p.retailer) + '</span>' : '') +
      '</a>';
    }

    function renderError(url) {
      return '<a href="' + escAttr(url) + '" target="_blank" rel="noopener" class="product-card">' +
        '<div class="product-card-image" style="background:var(--light-grey);"></div>' +
        '<p class="product-name" style="color:var(--text-light);">View on endource →</p>' +
      '</a>';
    }

    // Fetch all product URLs in parallel
    Promise.allSettled(
      productUrls.map(function(url) {
        var endpoint = '/.netlify/functions/endource-product?url=' + encodeURIComponent(url);
        return fetch(endpoint)
          .then(function(res) { return res.json(); })
          .then(function(data) {
            if (data.product && data.product.name) {
              return { ok: true, product: data.product, url: url };
            }
            return { ok: false, url: url };
          })
          .catch(function() {
            return { ok: false, url: url };
          });
      })
    ).then(function(results) {
      grid.innerHTML = results.map(function(result) {
        if (result.status === 'fulfilled' && result.value.ok) {
          return renderProduct(result.value.product, result.value.url);
        }
        var url = result.status === 'fulfilled' ? result.value.url : '';
        return renderError(url);
      }).join('');
    });
  })();
</script>