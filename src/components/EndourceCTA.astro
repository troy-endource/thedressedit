---
interface Props {
  text?: string;
  url?: string;
  buttonText?: string;
}

const { 
  text = "Every dress in this guide is available to shop in one place. endource curates the best from 50+ UK retailers.",
  url = "https://www.endource.com",
  buttonText = "Shop on endource"
} = Astro.props;
---

<div class="endource-cta-block">
  <div class="endource-cta-inner">
    <div>
      <p class="endource-cta-label">endource × the dress edit</p>
      <p style="font-family: var(--sans); font-size: 13px; font-weight: 300; color: rgba(255,255,255,0.65); line-height: 1.6;">
        {text}
      </p>
    </div>
    <a href={url} target="_blank" class="endource-cta-btn">
      {buttonText} →
    </a>
  </div>
</div>
