---
interface Product {
  brand: string;
  name: string;
  price: string;
  retailer: string;
  image?: string;
  url: string;
  badge?: string;
}

interface Props {
  sectionTitle: string;
  products: Product[];
  endourceLink?: string;
}

const { sectionTitle, products, endourceLink } = Astro.props;

function getBadgeClass(badge: string): string {
  const map: Record<string, string> = {
    'editors-pick': 'badge-pick',
    'best-value': 'badge-value',
    'new-in': 'badge-new',
    'sale': 'badge-sale',
  };
  return map[badge] || '';
}

function getBadgeLabel(badge: string): string {
  const map: Record<string, string> = {
    'editors-pick': "Editor's Pick",
    'best-value': 'Best Value',
    'new-in': 'New In',
    'sale': 'Sale',
  };
  return map[badge] || '';
}
---

<section class="product-section">
  <div class="product-section-header">
    <h3>{sectionTitle}</h3>
    {endourceLink && (
      <a href={endourceLink} target="_blank" class="product-section-cta">
        Shop all on Endource →
      </a>
    )}
  </div>
  <div class="product-grid">
    {products.map(product => (
      <a href={product.url} target="_blank" class="product-card">
        <div class="product-image">
          {product.image ? (
            <img src={product.image} alt={`${product.brand} ${product.name}`} loading="lazy" />
          ) : null}
          {product.badge && (
            <span class={`product-badge ${getBadgeClass(product.badge)}`}>
              {getBadgeLabel(product.badge)}
            </span>
          )}
        </div>
        <div class="product-details">
          <div class="product-brand">{product.brand}</div>
          <div class="product-name">{product.name}</div>
          <div class="product-price">{product.price}</div>
          <div class="product-retailer">via {product.retailer}</div>
          <div class="product-shop-link">Shop on Endource →</div>
        </div>
      </a>
    ))}
  </div>
</section>
