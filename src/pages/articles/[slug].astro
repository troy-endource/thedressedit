---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import StylistTip from '../../components/StylistTip.astro';
import EndourceCTA from '../../components/EndourceCTA.astro';

const articles = await Astro.glob('../../content/articles/*.md');

const { slug } = Astro.params;
const article = articles.find(a => {
  const fileSlug = a.file.split('/').pop()?.replace('.md', '');
  return fileSlug === slug;
});

if (!article) {
  return Astro.redirect('/404');
}

const { frontmatter, compiledContent } = article;

function formatDate(dateStr: string): string {
  if (!dateStr) return '';
  const d = new Date(dateStr);
  return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}

const htmlContent = compiledContent();
const h2Regex = /<h2[^>]*>(.*?)<\/h2>/gi;
const headings: { text: string; id: string }[] = [];
let match;
while ((match = h2Regex.exec(htmlContent)) !== null) {
  const text = match[1].replace(/<[^>]+>/g, '');
  const id = text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
  headings.push({ text, id });
}

let processedContent = htmlContent;
headings.forEach(h => {
  processedContent = processedContent.replace(
    `<h2>${h.text}</h2>`,
    `<h2 id="${h.id}">${h.text}</h2>`
  );
});

// Split content into sections at each H2 boundary
// Each section = { heading: string | null, html: string }
const sections: { heading: string | null; html: string }[] = [];
const splitRegex = /<h2[^>]*id="[^"]*"[^>]*>(.*?)<\/h2>/gi;
let lastIndex = 0;
let splitMatch;
const splitMatches: { index: number; fullMatch: string; headingText: string }[] = [];

while ((splitMatch = splitRegex.exec(processedContent)) !== null) {
  splitMatches.push({
    index: splitMatch.index,
    fullMatch: splitMatch[0],
    headingText: splitMatch[1].replace(/<[^>]+>/g, ''),
  });
}

if (splitMatches.length === 0) {
  // No H2s — entire body is one section
  sections.push({ heading: null, html: processedContent });
} else {
  // Content before the first H2
  if (splitMatches[0].index > 0) {
    sections.push({ heading: null, html: processedContent.substring(0, splitMatches[0].index) });
  }
  // Each H2 section
  for (let i = 0; i < splitMatches.length; i++) {
    const start = splitMatches[i].index;
    const end = i + 1 < splitMatches.length ? splitMatches[i + 1].index : processedContent.length;
    sections.push({
      heading: splitMatches[i].headingText,
      html: processedContent.substring(start, end),
    });
  }
}

// Build lookup maps for insertAfter
const productsByHeading: Record<string, typeof frontmatter.productSections> = {};
(frontmatter.productSections || []).forEach((section: any) => {
  const key = (section.insertAfter || '').trim().toLowerCase();
  if (!productsByHeading[key]) productsByHeading[key] = [];
  productsByHeading[key].push(section);
});

const tipsByHeading: Record<string, typeof frontmatter.stylistTips> = {};
(frontmatter.stylistTips || []).forEach((tip: any) => {
  const key = (tip.insertAfter || '').trim().toLowerCase();
  if (!tipsByHeading[key]) tipsByHeading[key] = [];
  tipsByHeading[key].push(tip);
});

// Track which product sections have been placed (for endource CTA positioning)
const totalProductSections = (frontmatter.productSections || []).length;
let productSectionCount = 0;
const ctaAfterIndex = Math.floor((totalProductSections - 1) / 2);

const clusterNames: Record<string, string> = {
  'summer-dresses': 'Summer Dresses',
  'wedding-guest': 'Wedding Guest',
  'work-dresses': 'Work Dresses',
  'trends-2026': 'Trends 2026',
  'body-shape': 'Body Shape',
  'occasions': 'Occasions',
  'budget-sales': 'Budget & Sales',
  'fabric-care': 'Fabric & Care',
};
const clusterName = clusterNames[frontmatter.cluster] || frontmatter.cluster;
const relatedArticles = frontmatter.relatedArticles || [];

export async function getStaticPaths() {
  const allArticles = await Astro.glob('../../content/articles/*.md');
  return allArticles.map(article => ({
    params: { slug: article.file.split('/').pop()?.replace('.md', '') },
  }));
}
---

<BaseLayout 
  title={frontmatter.seoTitle || frontmatter.title} 
  description={frontmatter.description}
  activeNav={frontmatter.cluster}
>

<!-- Open Graph / Discover -->
<Fragment slot="head">
  <meta property="og:title" content={frontmatter.seoTitle || frontmatter.title} />
  <meta property="og:description" content={frontmatter.description || frontmatter.subtitle || ''} />
  <meta property="og:type" content="article" />
  <meta property="og:url" content={`https://thedressedit.co.uk/articles/${slug}/`} />
  {frontmatter.heroImage && <meta property="og:image" content={frontmatter.heroImage} />}
  <meta property="article:published_time" content={frontmatter.publishDate} />
  <meta property="article:author" content={frontmatter.author} />
  <meta property="article:section" content={clusterName} />
</Fragment>

<!-- Reading Progress Bar -->
<div class="reading-progress" id="readingProgress"></div>

<!-- Article Hero -->
<section class="article-hero">
  <div class="article-hero-content">
    <p class="article-tag">{clusterName}</p>
    <h1 class="article-title">{frontmatter.title}</h1>
    {frontmatter.subtitle && (
      <p class="article-subtitle">{frontmatter.subtitle}</p>
    )}
    <p class="article-meta">
      By <strong>{frontmatter.author}</strong> · {formatDate(frontmatter.publishDate)} · {frontmatter.readTime} min read
    </p>
  </div>
  <div class="article-hero-image">
    {frontmatter.heroImage ? (
      <img src={frontmatter.heroImage} alt={frontmatter.heroImageAlt || frontmatter.title} />
    ) : (
      <div style="width:100%;height:100%;min-height:460px;background:var(--light-grey);"></div>
    )}
  </div>
</section>

<!-- Table of Contents -->
{headings.length > 0 && (
  <div class="toc-wrap">
    <div class="toc-box">
      <p class="toc-label">In This Guide</p>
      <ol class="toc-list">
        {headings.map(h => (
          <li><a href={`#${h.id}`}>{h.text}</a></li>
        ))}
      </ol>
    </div>
  </div>
)}

<!-- Article Body with Interspersed Products & Tips -->
{sections.map((section) => {
  const headingKey = (section.heading || '').trim().toLowerCase();
  const matchedProducts = productsByHeading[headingKey] || [];
  const matchedTips = tipsByHeading[headingKey] || [];

  return (
    <>
      <article class="article-body" set:html={section.html} />

      {matchedTips.map((tip: any) => (
        <StylistTip title={tip.title} text={tip.text} />
      ))}

      {matchedProducts.map((ps: any) => {
        const currentIndex = productSectionCount++;
        const showCta = currentIndex === ctaAfterIndex;
        return (
          <>
            <ProductGrid 
              sectionTitle={ps.sectionTitle}
              products={ps.products}
              endourceLink={ps.sectionEndourceLink}
            />
            {showCta && (
              <EndourceCTA 
                text={frontmatter.endourceCta || "Shop the Edit on endource"}
                url={frontmatter.endourceLink || "https://www.endource.com"}
              />
            )}
          </>
        );
      })}
    </>
  );
})}

<!-- Endource Final CTA -->
{frontmatter.endourceLink && (
  <div class="endource-cta-block">
    <div class="endource-cta-inner">
      <div>
        <p class="endource-cta-label">endource × the dress edit</p>
        <h3>{frontmatter.endourceCta || "Shop This Edit on endource"}</h3>
      </div>
      <a href={frontmatter.endourceLink} target="_blank" class="endource-cta-btn">
        Browse on endource →
      </a>
    </div>
  </div>
)}

<!-- Related Articles -->
{relatedArticles.length > 0 && (
  <section class="related-section">
    <h2 class="section-title">More from the Edit</h2>
    <div class="related-grid">
      {relatedArticles.slice(0, 3).map((rel: any) => (
        <a href={rel.url} class="related-card">
          <div class="related-thumb"></div>
          <p class="related-cluster">{rel.cluster}</p>
          <h3 class="related-title">{rel.title}</h3>
        </a>
      ))}
    </div>
  </section>
)}

<!-- Author Bio -->
<div class="author-bio">
  <div class="author-avatar"></div>
  <div class="author-info">
    <p class="author-name">{frontmatter.author}</p>
    <p class="author-role">{frontmatter.authorRole}</p>
    <p class="author-desc">
      Writing about style, fashion, and finding the perfect dress — so you don't have to spend hours searching.
    </p>
  </div>
</div>

<!-- Affiliate Disclosure -->
<div class="affiliate-disclosure">
  <p>
    This article contains affiliate links. the dress edit is curated by <a href="https://www.endource.com" target="_blank">endource</a>. When you shop through our links, we may earn a commission at no extra cost to you. We only feature products our editors recommend.
  </p>
</div>

<!-- Reading Progress Script -->
<script>
  window.addEventListener('scroll', () => {
    const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
    const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    const scrolled = (winScroll / height) * 100;
    const bar = document.getElementById('readingProgress');
    if (bar) bar.style.width = scrolled + '%';
  });
</script>

</BaseLayout>