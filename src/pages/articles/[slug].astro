---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import StylistTip from '../../components/StylistTip.astro';
import EndourceCTA from '../../components/EndourceCTA.astro';

// Get all articles from the content folder
const articles = await Astro.glob('../../content/articles/*.md');

// Find the article matching this URL slug
const { slug } = Astro.params;
const article = articles.find(a => {
  const fileSlug = a.file.split('/').pop()?.replace('.md', '');
  return fileSlug === slug;
});

if (!article) {
  return Astro.redirect('/404');
}

const { frontmatter, compiledContent } = article;
const Content = article.Content;

// Format the date
function formatDate(dateStr: string): string {
  if (!dateStr) return '';
  const d = new Date(dateStr);
  return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}

// Extract H2 headings from compiled HTML for table of contents
const htmlContent = compiledContent();
const h2Regex = /<h2[^>]*>(.*?)<\/h2>/gi;
const headings: { text: string; id: string }[] = [];
let match;
while ((match = h2Regex.exec(htmlContent)) !== null) {
  const text = match[1].replace(/<[^>]+>/g, '');
  const id = text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
  headings.push({ text, id });
}

// Add IDs to the h2 tags in the content
let processedContent = htmlContent;
headings.forEach(h => {
  processedContent = processedContent.replace(
    `<h2>${h.text}</h2>`,
    `<h2 id="${h.id}">${h.text}</h2>`
  );
});

// Cluster name map
const clusterNames: Record<string, string> = {
  'summer-dresses': 'Summer Dresses',
  'wedding-guest': 'Wedding Guest',
  'work-dresses': 'Work Dresses',
  'trends-2026': 'Trends 2026',
  'body-shape': 'Body Shape',
  'occasions': 'Occasions',
  'budget-sales': 'Budget & Sales',
  'fabric-care': 'Fabric & Care',
};
const clusterName = clusterNames[frontmatter.cluster] || frontmatter.cluster;

// Get related articles data
const relatedArticles = frontmatter.relatedArticles || [];

// Static paths
export async function getStaticPaths() {
  const allArticles = await Astro.glob('../../content/articles/*.md');
  return allArticles.map(article => ({
    params: { slug: article.file.split('/').pop()?.replace('.md', '') },
  }));
}
---

<BaseLayout 
  title={frontmatter.seoTitle || frontmatter.title} 
  description={frontmatter.description}
  activeNav={frontmatter.cluster}
>

<style>
  .article-hero-split {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 2rem 3rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .article-hero-split .hero-text {
    order: 1;
  }
  .article-hero-split .hero-image {
    order: 2;
  }
  .hero-image-container {
    width: 100%;
    max-height: 600px;
    overflow: hidden;
    background: linear-gradient(155deg, var(--blush) 0%, var(--cream) 35%, var(--rose) 100%);
  }
  .hero-image-container img {
    width: 100%;
    height: 100%;
    max-height: 600px;
    object-fit: cover;
    object-position: top center;
    display: block;
  }
  .hero-placeholder-split {
    width: 100%;
    height: 400px;
    background: linear-gradient(155deg, var(--blush) 0%, var(--cream) 35%, var(--rose) 100%);
  }

  @media (max-width: 768px) {
    .article-hero-split {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 1.5rem 1.5rem 0;
    }
    .article-hero-split .hero-text {
      order: 2;
    }
    .article-hero-split .hero-image {
      order: 1;
    }
    .hero-image-container {
      max-height: 400px;
    }
    .hero-image-container img {
      max-height: 400px;
    }
  }
</style>

<!-- Reading Progress Bar -->
<div class="reading-progress" id="readingProgress"></div>

<!-- Share Bar -->
<div class="share-bar">
  <a href="#" class="share-btn" title="Share on Pinterest">P</a>
  <a href="#" class="share-btn" title="Share on Facebook">f</a>
  <a href="#" class="share-btn" title="Share on X">𝕏</a>
  <a href="#" class="share-btn" title="Copy link">⌘</a>
</div>

<!-- Breadcrumb -->
<nav class="breadcrumb">
  <a href="/">Home</a> <span>›</span> 
  <a href={`/${frontmatter.cluster}/`}>{clusterName}</a> <span>›</span> 
  {frontmatter.title}
</nav>

<!-- Article Hero: Side-by-Side Layout -->
<div class="article-hero-split">
  <div class="hero-text">
    <span class="article-cluster-tag">{clusterName}</span>
    <h1 class="article-h1">{frontmatter.title}</h1>
    {frontmatter.subtitle && (
      <p class="article-subtitle">{frontmatter.subtitle}</p>
    )}
    <div class="article-meta-bar">
      <span class="author">By {frontmatter.author}</span>
      <span class="meta-dot"></span>
      <span>{formatDate(frontmatter.publishDate)}</span>
      <span class="meta-dot"></span>
      <span>{frontmatter.readTime} min read</span>
      {frontmatter.updatedDate && (
        <>
          <span class="meta-dot"></span>
          <span>Updated {formatDate(frontmatter.updatedDate)}</span>
        </>
      )}
    </div>
  </div>
  <div class="hero-image">
    <div class="hero-image-container">
      {frontmatter.heroImage ? (
        <img src={frontmatter.heroImage} alt={frontmatter.heroImageAlt || frontmatter.title} />
      ) : (
        <div class="hero-placeholder-split"></div>
      )}
    </div>
    {frontmatter.heroImageCredit && (
      <p class="image-credit">Photo: {frontmatter.heroImageCredit}</p>
    )}
  </div>
</div>

<!-- Table of Contents -->
{headings.length > 0 && (
  <div class="toc">
    <div class="toc-inner">
      <h2>In This Guide</h2>
      <ol>
        {headings.map(h => (
          <li><a href={`#${h.id}`}>{h.text}</a></li>
        ))}
      </ol>
    </div>
  </div>
)}

<!-- Article Body -->
<article class="article-body" set:html={processedContent} />

<!-- Product Sections -->
{frontmatter.productSections?.map((section: any, i: number) => (
  <>
    <ProductGrid 
      sectionTitle={section.sectionTitle}
      products={section.products}
      endourceLink={section.sectionEndourceLink}
    />
    {i === Math.floor((frontmatter.productSections.length - 1) / 2) && (
      <EndourceCTA 
        text={frontmatter.endourceCta || "Shop the Edit on endource"}
        url={frontmatter.endourceLink || "https://www.endource.com"}
      />
    )}
  </>
))}

<!-- Stylist Tips - render after article body -->
{frontmatter.stylistTips?.map((tip: any) => (
  <StylistTip title={tip.title} text={tip.text} />
))}

<!-- Endource Final CTA -->
{frontmatter.endourceLink && (
  <div class="endource-cta-block">
    <div class="endource-cta-inner">
      <p class="endource-cta-label">endource × The Dress Edit</p>
      <h3>{frontmatter.endourceCta || "Shop This Edit on endource"}</h3>
      <a href={frontmatter.endourceLink} target="_blank" class="endource-cta-btn">
        Browse on endource →
      </a>
    </div>
  </div>
)}

<!-- Related Articles -->
{relatedArticles.length > 0 && (
  <section class="related-articles">
    <h2 class="related-heading">
      <span class="label">Keep Reading</span>
      More from The Dress <em>Edit</em>
    </h2>
    <div class="related-grid">
      {relatedArticles.slice(0, 3).map((rel: any) => (
        <a href={rel.url} class="related-card">
          <div class="related-thumb"></div>
          <p class="related-cluster">{rel.cluster}</p>
          <h3 class="related-title">{rel.title}</h3>
        </a>
      ))}
    </div>
  </section>
)}

<!-- Author Bio -->
<div class="author-bio">
  <div class="author-avatar"></div>
  <div class="author-info">
    <p class="author-name">{frontmatter.author}</p>
    <p class="author-role">{frontmatter.authorRole}</p>
    <p class="author-desc">
      Writing about style, fashion, and finding the perfect dress — so you don't have to spend hours searching.
    </p>
  </div>
</div>

<!-- Affiliate Disclosure -->
<div class="affiliate-disclosure">
  <p>
    <strong>Affiliate Disclosure:</strong> The Dress Edit is powered by 
    <a href="https://www.endource.com" target="_blank">endource</a>. 
    We may earn a commission when you shop through our links, at no extra cost to you. 
    We only recommend products we genuinely love.
  </p>
</div>

<!-- Reading Progress Script -->
<script>
  window.addEventListener('scroll', () => {
    const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
    const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    const scrolled = (winScroll / height) * 100;
    const bar = document.getElementById('readingProgress');
    if (bar) bar.style.width = scrolled + '%';
  });
</script>

</BaseLayout>
