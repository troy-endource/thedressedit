---
import BaseLayout from '../layouts/BaseLayout.astro';

const allArticles = await Astro.glob('../content/articles/*.md');

const articles = allArticles
  .sort((a, b) => new Date(b.frontmatter.publishDate).getTime() - new Date(a.frontmatter.publishDate).getTime());

const featured = articles.find(a => a.frontmatter.featured) || articles[0];
const editPicks = articles.filter(a => a !== featured).slice(0, 4);
const otherArticles = articles.filter(a => a !== featured && !editPicks.includes(a)).slice(0, 3);

function getSlug(article: any): string {
  return article.file.split('/').pop()?.replace('.md', '') || '';
}

const clusterNames: Record<string, string> = {
  'wedding-guest': 'Wedding Guest',
  'party-dresses': 'Party Dresses',
  'maxi-dresses': 'Maxi Dresses',
  'midi-dresses': 'Midi Dresses',
  'mini-dresses': 'Mini Dresses',
  'beach-dresses': 'Beach Dresses',
  'wrap-dresses': 'Wrap Dresses',
  'shirt-dresses': 'Shirt Dresses',
  'floral-dresses': 'Floral Dresses',
  'seen-this-season': 'Seen This Season',
  'new-in': 'New In',
  'sale': 'Sale',
};
---

<BaseLayout title="Your UK Dress Style Guide" activeNav="">

<!-- Hero Block -->
{featured && (
  <a href={`/articles/${getSlug(featured)}/`} class="hero-block" style="text-decoration: none;">
    <div class="hero-block-image">
      {featured.frontmatter.image ? (
        <img src={featured.frontmatter.image} alt={featured.frontmatter.imageAlt || featured.frontmatter.title} />
      ) : (
        <div style="width:100%;height:100%;min-height:480px;background:var(--light-grey);"></div>
      )}
    </div>
    <div class="hero-block-content">
      <h1 class="hero-block-title">{featured.frontmatter.title}</h1>
      {featured.frontmatter.subtitle && (
        <p class="hero-block-desc">{featured.frontmatter.subtitle}</p>
      )}
      <span class="see-more">Read the guide</span>
    </div>
  </a>
)}

<!-- Latest from the Edit -->
{editPicks.length > 0 && (
  <section class="edit-section">
    <h2 class="section-title">Latest from the Edit</h2>
    <div class="edit-grid">
      {editPicks.map((article, i) => (
        <a href={`/articles/${getSlug(article)}/`} class="edit-card">
          <div class="edit-card-image">
            {article.frontmatter.image ? (
              <img src={article.frontmatter.image} alt={article.frontmatter.imageAlt || ''} />
            ) : (
              <div style="width:100%;height:100%;background:var(--light-grey);"></div>
            )}
          </div>
          <p class="edit-card-num">{i + 1}</p>
          <p class="edit-card-label">{clusterNames[article.frontmatter.cluster] || article.frontmatter.cluster}</p>
        </a>
      ))}
    </div>
  </section>
)}

<!-- New In This Week — Product Carousel -->
<section class="newin-carousel-section">
  <div class="newin-carousel-header">
    <div>
      <h2 class="section-title">New In This Week</h2>
      <p class="newin-carousel-desc">The latest dress arrivals, handpicked by endource's editors.</p>
    </div>
    <a href="/new-in/" class="see-more">See all</a>
  </div>
  <div class="newin-carousel-wrap">
    <div class="newin-carousel" id="newinCarousel">
      <div class="newin-skeleton"><div class="newin-skeleton-img"></div><div class="newin-skeleton-text short"></div><div class="newin-skeleton-text"></div><div class="newin-skeleton-text price"></div></div>
      <div class="newin-skeleton"><div class="newin-skeleton-img"></div><div class="newin-skeleton-text short"></div><div class="newin-skeleton-text"></div><div class="newin-skeleton-text price"></div></div>
      <div class="newin-skeleton"><div class="newin-skeleton-img"></div><div class="newin-skeleton-text short"></div><div class="newin-skeleton-text"></div><div class="newin-skeleton-text price"></div></div>
      <div class="newin-skeleton"><div class="newin-skeleton-img"></div><div class="newin-skeleton-text short"></div><div class="newin-skeleton-text"></div><div class="newin-skeleton-text price"></div></div>
      <div class="newin-skeleton"><div class="newin-skeleton-img"></div><div class="newin-skeleton-text short"></div><div class="newin-skeleton-text"></div><div class="newin-skeleton-text price"></div></div>
    </div>
  </div>
</section>

<!-- More Articles (if any) -->
{otherArticles.length > 0 && (
  <section class="edit-section">
    <h2 class="section-title">More from the Edit</h2>
    <div class="edit-grid" style="grid-template-columns: repeat(3, 1fr);">
      {otherArticles.map((article, i) => (
        <a href={`/articles/${getSlug(article)}/`} class="edit-card">
          <div class="edit-card-image">
            {article.frontmatter.image ? (
              <img src={article.frontmatter.image} alt={article.frontmatter.imageAlt || ''} />
            ) : (
              <div style="width:100%;height:100%;background:var(--light-grey);"></div>
            )}
          </div>
          <p class="edit-card-num">{i + 1}</p>
          <p class="edit-card-label">{clusterNames[article.frontmatter.cluster] || article.frontmatter.cluster}</p>
        </a>
      ))}
    </div>
  </section>
)}

<script is:inline>
  var EDIT_URL = 'https://www.endource.com/edit/new-in-this-week/Wm9ZRcnnfAABTqZ8?categories%5B%5D=3';

  function esc(str) {
    if (!str) return '';
    var d = document.createElement('div');
    d.textContent = String(str);
    return d.innerHTML;
  }

  function escAttr(str) {
    if (!str) return '';
    return String(str).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function formatPrice(price, currency) {
    if (!price && price !== 0) return '';
    var priceStr = String(price);
    if (priceStr.match(/[£$€]/)) return priceStr;
    var num = parseFloat(priceStr.replace(/[^0-9.]/g, ''));
    if (isNaN(num)) return priceStr;
    var symbol = '£';
    if (currency === 'USD') symbol = '$';
    if (currency === 'EUR') symbol = '€';
    if (num % 1 === 0) return symbol + num.toLocaleString('en-GB');
    return symbol + num.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function loadNewIn() {
    var endpoint = '/.netlify/functions/endource-product?url=' + encodeURIComponent(EDIT_URL);
    var carousel = document.getElementById('newinCarousel');

    fetch(endpoint)
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (data.error || !data.products || data.products.length === 0) {
          carousel.innerHTML = '<p style="font-size:13px;color:var(--text-light);padding:20px 0;">Couldn\'t load new arrivals. <a href="/new-in/" style="text-decoration:underline;">View the New In page</a></p>';
          return;
        }

        var products = data.products.filter(function(p) {
          return p.name && p.name.length > 0;
        });

        if (products.length === 0) {
          carousel.innerHTML = '<p style="font-size:13px;color:var(--text-light);padding:20px 0;">Couldn\'t load new arrivals. <a href="/new-in/" style="text-decoration:underline;">View the New In page</a></p>';
          return;
        }

        carousel.innerHTML = products.map(function(p) {
          var productUrl = p.url || EDIT_URL;
          if (productUrl.startsWith('/')) {
            productUrl = 'https://www.endource.com' + productUrl;
          }
          var priceDisplay = formatPrice(p.price, p.currency);

          return '<a href="' + escAttr(productUrl) + '" target="_blank" rel="noopener" class="newin-card">' +
            '<div class="newin-card-image">' +
              (p.image ? '<img src="' + escAttr(p.image) + '" alt="' + escAttr(p.name) + '" loading="lazy" />' : '') +
            '</div>' +
            (p.brand ? '<p class="newin-card-brand">' + esc(p.brand) + '</p>' : '') +
            '<p class="newin-card-name">' + esc(p.name) + '</p>' +
            (priceDisplay ? '<span class="newin-card-price">' + esc(priceDisplay) + '</span>' : '') +
            (p.retailer ? ' <span class="newin-card-retailer">' + esc(p.retailer) + '</span>' : '') +
          '</a>';
        }).join('');
      })
      .catch(function() {
        carousel.innerHTML = '<p style="font-size:13px;color:var(--text-light);padding:20px 0;">Couldn\'t load new arrivals. <a href="/new-in/" style="text-decoration:underline;">View the New In page</a></p>';
      });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadNewIn);
  } else {
    loadNewIn();
  }
</script>

</BaseLayout>
