---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  activeNav?: string;
}

const { title, description = "Your UK Dress Style Guide — Curated by endource", activeNav = "" } = Astro.props;

// Build search index at compile time
const allArticles = await Astro.glob('../content/articles/*.md');
const searchIndex = allArticles.map((a: any) => ({
  title: a.frontmatter.title || '',
  description: a.frontmatter.description || '',
  subtitle: a.frontmatter.subtitle || '',
  cluster: a.frontmatter.cluster || '',
  slug: a.file.split('/').pop()?.replace('.md', '') || '',
}));

// Load nav from navigation.json
import navData from '../content/settings/navigation.json';
const navItems = navData.items;
---
<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} — the dress edit</title>
  <meta name="description" content={description}>
  <meta name="google-site-verification" content="JXOjRk-h7_jkwpVHl-pNROSiR-MJlcjclMj5bP-Mi3c" />
  <meta name="robots" content="max-image-preview:large" />
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300;1,9..40,400&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/netlify-identity-widget@1/build/netlify-identity-widget.js"></script>
  <slot name="head" />
</head>
<body>

<!-- Announcement Bar -->
<div class="announce-bar">
  <div class="announce-bar-inner">
    <span>the dress edit — your curated UK dress style guide</span>
    <span>Shop 50+ brands in one place on endource</span>
    <span>the dress edit — your curated UK dress style guide</span>
    <span>Shop 50+ brands in one place on endource</span>
    <span>the dress edit — your curated UK dress style guide</span>
    <span>Shop 50+ brands in one place on endource</span>
  </div>
</div>

<!-- Header -->
<header class="header">
  <a href="/" class="logo">the dress edit</a>
  <div class="search-bar" id="search-bar">
    <input type="text" id="search-input" placeholder="Search dresses, trends, guides..." autocomplete="off" />
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <div class="search-dropdown" id="search-dropdown"></div>
  </div>
  <div class="header-icons">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
  </div>
</header>

<!-- Nav -->
<nav class="nav">
  {navItems.map((item: { label: string; url: string }) => (
    <a href={item.url}>{item.label}</a>
  ))}
</nav>

<slot />

<!-- Newsletter -->
<section class="newsletter">
  <h2 class="newsletter-title">The Weekly Dress Edit</h2>
  <p class="newsletter-sub">New arrivals, sale alerts, and styling ideas — every Thursday</p>
  <div class="newsletter-form">
    <input type="email" placeholder="your@email.com" />
    <button>Subscribe</button>
  </div>
</section>

<!-- Footer -->
<footer class="footer">
  <p class="footer-logo">the dress edit</p>
  <div class="footer-links">
    {navItems.map((item: { label: string; url: string }) => (
      <a href={item.url}>{item.label}</a>
    ))}
    <a href="https://www.endource.com" target="_blank" rel="noopener">Shop on endource</a>
    <a href="/about/">About</a>
    <a href="/contact/">Contact</a>
  </div>
  <p class="footer-legal">&copy; 2026 the dress edit &middot; curated by <a href="https://www.endource.com" target="_blank" rel="noopener">endource</a> &middot; This site contains affiliate links</p>
</footer>


<style>
  .search-bar { position: relative; }
  .search-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    background: var(--white);
    border: 1px solid var(--border);
    z-index: 200;
    box-shadow: 0 8px 32px rgba(0,0,0,0.07);
  }
  .search-dropdown.open { display: block; }
  .search-result {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 11px 16px;
    border-bottom: 1px solid var(--mid-grey);
    text-decoration: none;
    color: var(--text-dark);
    transition: background 0.15s;
    overflow: hidden;
  }
  .search-result:last-of-type { border-bottom: none; }
  .search-result:hover { background: var(--light-grey); }
  .search-result-title {
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 500;
    color: var(--text-dark);
    white-space: nowrap;
    flex-shrink: 0;
    letter-spacing: 0.01em;
  }
  .search-result-desc {
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 300;
    color: var(--text-light);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }
  .search-result-endource {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    background: transparent;
    text-decoration: none;
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 400;
    color: var(--text-light);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-top: 1px solid var(--border);
    transition: color 0.15s;
  }
  .search-result-endource:hover { color: var(--text-dark); }
  .search-result-endource svg { opacity: 0.5; }
  .search-result-endource:hover svg { opacity: 1; }
  .search-no-results {
    padding: 12px 16px;
    font-family: var(--sans);
    font-size: 12px;
    color: var(--text-light);
  }
</style>

<script define:vars={{ searchIndex }}>
  const input = document.getElementById('search-input');
  const dropdown = document.getElementById('search-dropdown');

  function escapeHtml(str) {
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function runSearch(query) {
    const q = query.trim().toLowerCase();
    if (!q) { dropdown.classList.remove('open'); return; }

    const results = searchIndex.filter(function(article) {
      return (
        article.title.toLowerCase().includes(q) ||
        article.description.toLowerCase().includes(q) ||
        article.subtitle.toLowerCase().includes(q) ||
        article.cluster.toLowerCase().includes(q)
      );
    }).slice(0, 5);

    let html = '';

    if (results.length === 0) {
      html += '<div class="search-no-results">No articles found for \"' + escapeHtml(query) + '\"</div>';
    } else {
      results.forEach(function(r) {
        html += '<a class="search-result" href="/articles/' + escapeHtml(r.slug) + '/">' +
          '<div class="search-result-title">' + escapeHtml(r.title) + '</div>' +
          '<div class="search-result-desc">— ' + escapeHtml(r.description) + '</div>' +
          '</a>';
      });
    }

    var endourceUrl = 'https://www.endource.com/search?q=' + encodeURIComponent(query);
    html += '<a class="search-result-endource" href="' + endourceUrl + '" target="_blank" rel="noopener">' +
      '<span>Search \"' + escapeHtml(query) + '\" on endource</span>' +
      '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>' +
      '</a>';

    dropdown.innerHTML = html;
    dropdown.classList.add('open');
  }

  input.addEventListener('input', function(e) { runSearch(e.target.value); });

  input.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') {
      var q = input.value.trim();
      if (q) window.open('https://www.endource.com/search?q=' + encodeURIComponent(q), '_blank');
    }
    if (e.key === 'Escape') {
      dropdown.classList.remove('open');
      input.blur();
    }
  });

  document.addEventListener('click', function(e) {
    var bar = document.getElementById('search-bar');
    if (bar && !bar.contains(e.target)) {
      dropdown.classList.remove('open');
    }
  });
</script>

<script>
  if (window.netlifyIdentity) {
    window.netlifyIdentity.on("init", user => {
      if (!user) {
        window.netlifyIdentity.on("login", () => {
          document.location.href = "/admin/";
        });
      }
    });
  }
</script>

</body>
</html>
