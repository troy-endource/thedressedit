---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  activeNav?: string;
}

const { title, description = "Your UK Dress Style Guide — Curated by endource", activeNav = "" } = Astro.props;

const navItems = [
  { label: "Wedding Guest", url: "/wedding-guest/", slug: "wedding-guest" },
  { label: "Trends", url: "/trends-2026/", slug: "trends-2026" },
  { label: "Summer", url: "/summer-dresses/", slug: "summer-dresses" },
  { label: "Work", url: "/work-dresses/", slug: "work-dresses" },
  { label: "Body Shape", url: "/body-shape/", slug: "body-shape" },
  { label: "Sale", url: "/budget-sales/", slug: "budget-sales" },
  { label: "New In", url: "/new-in/", slug: "" },
];
---
<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} — the dress edit</title>
  <meta name="description" content={description}>
  <meta name="google-site-verification" content="JXOjRk-h7_jkwpVHl-pNROSiR-MJlcjclMj5bP-Mi3c" />
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300;1,9..40,400&display=swap" rel="stylesheet">
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>
<body>

<!-- Announcement Bar -->
<div class="announce-bar">
  <div class="announce-bar-inner">
    <span>the dress edit — your curated UK dress style guide</span>
    <span>Shop 50+ brands in one place on endource</span>
    <span>the dress edit — your curated UK dress style guide</span>
    <span>Shop 50+ brands in one place on endource</span>
    <span>the dress edit — your curated UK dress style guide</span>
    <span>Shop 50+ brands in one place on endource</span>
  </div>
</div>

<!-- Header -->
<header class="header">
  <a href="/" class="logo">the dress edit</a>
  <div class="search-bar">
    <input type="text" placeholder="Search dresses, trends, guides..." />
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
  </div>
  <div class="header-icons">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
  </div>
</header>

<!-- Nav -->
<nav class="nav">
  {navItems.map(item => (
    <a href={item.url}>{item.label}</a>
  ))}
</nav>

<slot />

<!-- Newsletter -->
<section class="newsletter">
  <h2 class="newsletter-title">The Weekly Dress Edit</h2>
  <p class="newsletter-sub">New arrivals, sale alerts, and styling ideas — every Thursday</p>
  <div class="newsletter-form">
    <input type="email" placeholder="your@email.com" />
    <button>Subscribe</button>
  </div>
</section>

<!-- Footer -->
<footer class="footer">
  <p class="footer-logo">the dress edit</p>
  <div class="footer-links">
    <a href="/">Home</a>
    <a href="/articles/wedding-guest-dresses-2026/">Wedding Guest</a>
    <a href="/articles/dress-trends-2026/">Trends</a>
    <a href="/articles/best-midi-dresses-work-uk-2026/">Work Dresses</a>
    <a href="https://www.endource.com" target="_blank">Shop on endource</a>
    <a href="#">About</a>
    <a href="#">Contact</a>
  </div>
  <p class="footer-legal">&copy; 2026 the dress edit &middot; curated by <a href="https://www.endource.com" target="_blank">endource</a> &middot; This site contains affiliate links</p>
</footer>

<script>
  if (window.netlifyIdentity) {
    window.netlifyIdentity.on("init", user => {
      if (!user) {
        window.netlifyIdentity.on("login", () => {
          document.location.href = "/admin/";
        });
      }
    });
  }
</script>

</body>
</html>
